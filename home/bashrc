[[ $- == *i* ]] || return

declare -A _theme
if [[ -r ~/.cache/theme/colors.sh ]]; then
  while IFS='=' read -r key value; do
    _theme[$key]=$value
  done < ~/.cache/theme/colors.sh
fi

_theme_hex() { printf '%s' "${_theme[$1]:-$2}"; }

_theme_rgb() {
  local h
  h=$(_theme_hex "$1" "$2")
  h=${h#\#}
  printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

_git_branch() {
  local branch
  branch=$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null) || return
  printf ' %s' "$branch"
}

PS1="\[\e[38;2;$(_theme_rgb fg '#ccc3b8')m\]\w\[\e[38;2;$(_theme_rgb fg2 '#7a7373')m\]\$(_git_branch) \[\e[38;2;$(_theme_rgb accent '#c8a46b')m\]❯\[\e[0m\] "
PS2="\[\e[38;2;$(_theme_rgb fg2 '#7a7373')m\]❯\[\e[0m\] "

LS_COLORS="di=1;38;2;$(_theme_rgb green '#8aa66a'):fi=0;38;2;$(_theme_rgb fg '#ccc3b8'):ln=0;38;2;$(_theme_rgb red '#c26a6a'):ex=1;38;2;$(_theme_rgb accent '#c8a46b')"
BAT_THEME=ansi
FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
FZF_DEFAULT_OPTS="
  --height=50% --reverse --border=rounded --prompt='❯ '
  --color=fg:$(_theme_hex fg1 '#93877c'),bg:$(_theme_hex bg '#282828'),hl:$(_theme_hex green '#8aa66a')
  --color=fg+:$(_theme_hex fg '#ccc3b8'),bg+:$(_theme_hex line '#4e4e4e'),hl+:$(_theme_hex accent '#c8a46b')
  --color=info:$(_theme_hex fg2 '#7a7373'),prompt:$(_theme_hex accent '#c8a46b'),pointer:$(_theme_hex accent '#c8a46b')
  --color=marker:$(_theme_hex green '#8aa66a'),spinner:$(_theme_hex fg2 '#7a7373'),header:$(_theme_hex fg1 '#93877c')
  --color=border:$(_theme_hex line '#4e4e4e'),gutter:$(_theme_hex bg '#282828')
"
export LS_COLORS BAT_THEME FZF_DEFAULT_COMMAND FZF_DEFAULT_OPTS

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=50000
HISTFILESIZE=100000
HISTTIMEFORMAT='%F %T '
shopt -s histappend histreedit histverify cmdhist checkwinsize

_Z_DATA=~/.z_data
_z_last=

_z_track() {
  [[ $PWD == "$_z_last" ]] && return
  _z_last=$PWD
  [[ $PWD == "$HOME" || $PWD == / ]] && return
  local tmp
  tmp=$(mktemp) || return
  {
    awk -F'|' -v dir="$PWD" '$1 != dir' "$_Z_DATA" 2>/dev/null | tail -n 999
    printf '%s|%s\n' "$PWD" "$EPOCHSECONDS"
  } > "$tmp" && mv "$tmp" "$_Z_DATA"
}

_z_list() {
  [[ -r $_Z_DATA ]] || return
  local dir time
  sort -t'|' -k2 -rn "$_Z_DATA" | while IFS='|' read -r dir time; do
    [[ -d $dir && $dir == *"$1"* ]] && printf '%s|%s\n' "$dir" "$time"
  done
}

_ago() {
  local age=$((EPOCHSECONDS - $1))
  if ((age < 3600)); then
    printf '%dm ago' $((age / 60))
  elif ((age < 86400)); then
    printf '%dh ago' $((age / 3600))
  elif ((age < 604800)); then
    printf '%dd ago' $((age / 86400))
  else
    printf '%dw ago' $((age / 604800))
  fi
}

z() {
  [[ -n $1 ]] || { cd ~ || return; return; }
  local dir
  dir=$(_z_list "$*" | head -n 1 | cut -d'|' -f1)
  if [[ -n $dir ]]; then
    cd "$dir" || return
  else
    printf 'z: nothing matches %s\n' "$*"
    return 1
  fi
}

zi() {
  local dir time pick
  pick=$(_z_list "$*" | while IFS='|' read -r dir time; do
    printf '%s\t%s\n' "$dir" "$(_ago "$time")"
  done | fzf --prompt='z ❯ ' --delimiter='\t' --tabstop=4) || return
  cd "${pick%%$'\t'*}" || return
}

