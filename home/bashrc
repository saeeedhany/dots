orphans() {
  local pkgs
  mapfile -t pkgs < <(pacman -Qtdq)
  ((${#pkgs[@]})) || { echo 'orphans: none'; return; }
  sudo pacman -Rns "${pkgs[@]}"
}

mkcd() { mkdir -p -- "$1" && cd -- "$1" || return; }

extract() {
  [[ -f $1 ]] || { printf 'extract: %s is not a file\n' "$1"; return 1; }
  case $1 in
    *.rar) unrar x -- "$1" ;;
    *.tar | *.tar.* | *.tgz | *.tbz2 | *.txz | *.zip | *.7z | *.iso) bsdtar -xf "$1" ;;
    *.gz) gunzip -k -- "$1" ;;
    *.bz2) bunzip2 -k -- "$1" ;;
    *.xz) unxz -k -- "$1" ;;
    *.zst) unzstd -- "$1" ;;
    *.Z) uncompress -- "$1" ;;
    *) printf 'extract: cannot extract %s\n' "$1"; return 1 ;;
  esac
}

fe() {
  local file
  file=$(fzf --preview 'bat --style=numbers --color=always {}' --preview-window=right:60%:wrap) || return
  "${EDITOR:-nvim}" "$file"
}

rg_fzf() {
  [[ -n $1 ]] || { echo 'usage: rg_fzf <text>'; return 1; }
  local file
  file=$(rg --files-with-matches --hidden --glob '!.git' -- "$1" |
    fzf --preview "rg --color=always --context 5 -- $(printf '%q' "$1") {}" --preview-window=right:60%:wrap) || return
  "${EDITOR:-nvim}" "$file"
}

ducks() { command du -sh -- * 2>/dev/null | sort -rh | head -n "${1:-10}"; }

