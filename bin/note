#!/usr/bin/env bash
set -euo pipefail

dir="${NOTES_DIR:-$HOME/notes}"
mkdir -p "$dir"
cd "$dir"

shopt -s nullglob
files=(*.md)
list=""
((${#files[@]})) && list="$(ls -t -- "${files[@]}" | sed 's/\.md$//')"

name="$(printf '%s' "$list" | dmenu -l 15 -p note)" || exit 0
name="${name%.md}"

case "$name" in
  "" | */* | .*) exit 0 ;;
esac

exec st -c note -g 40x12 -e nvim "$dir/$name.md"
