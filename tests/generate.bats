#!/usr/bin/env bats

load test_helper

setup() {
  setup_repo_root
  source "$REPO_ROOT/lib/log.sh"
  source "$REPO_ROOT/lib/theme.sh"
  source "$REPO_ROOT/lib/generate.sh"
}

copy_repo() {
  COPY="$BATS_TEST_TMPDIR/repo"
  rsync -a --exclude=.git --exclude=wallpapers --exclude=.remember --exclude=.superpowers --exclude=docs "$REPO_ROOT/" "$COPY/"
  setup_fake_home
  unset DISPLAY
}

@test "hex_hsl and hsl_hex round-trip" {
  [ "$(hsl_hex $(hex_hsl '#c8a46b'))" = "#c8a46b" ]
  [ "$(hsl_hex $(hex_hsl '#1b1f27'))" = "#1b1f27" ]
}

@test "mix blends in sRGB" {
  [ "$(mix '#000000' '#ffffff' 50)" = "#808080" ]
  [ "$(mix '#c8a46b' '#282828' 0)" = "#c8a46b" ]
}

@test "fix_contrast keeps the hue and reaches the target" {
  out=$(fix_contrast '#3a2a2a' '#282828' 4.5)
  awk -v r="$(contrast "$out" '#282828')" 'BEGIN { exit !(r >= 4.5) }'
  h1=$(hex_hsl '#3a2a2a' | cut -d' ' -f1); h2=$(hex_hsl "$out" | cut -d' ' -f1)
  awk -v a="$h1" -v b="$h2" 'BEGIN { d = a - b; if (d < 0) d = -d; exit !(d < 2) }'
}

@test "color_name gives the plain color word" {
  [ "$(color_name '#161717')" = black ]
  [ "$(color_name '#282828')" = grey ]
  [ "$(color_name '#e8e6e1')" = white ]
  [ "$(color_name '#1b1f27')" = blue ]
  [ "$(color_name '#2b2f2a')" = green ]
  [ "$(color_name '#3b2a1e')" = brown ]
  [ "$(color_name '#ff0000')" = red ]
  [ "$(color_name '#6a3d9a')" = purple ]
}

@test "generated themes are complete and readable for hard inputs" {
  for c in '#282828' '#161717' '#1b1f27' '#e8e6e1' '#000000' '#ffffff' '#808080' '#777777' '#ff0000' '#2b2f2a'; do
    generate_theme "$c" > "$BATS_TEST_TMPDIR/t"
    run theme_check "$BATS_TEST_TMPDIR/t"
    [ "$status" -eq 0 ] || { echo "$c: $output"; return 1; }
    grep -qx "bg=$c" "$BATS_TEST_TMPDIR/t"
  done
}

@test "theme new names, saves and applies the theme" {
  copy_repo
  run "$COPY/theme" new 2b2f2a
  [ "$status" -eq 0 ]
  [ -f "$COPY/themes/green" ]
  head -1 "$COPY/themes/green" | grep -q 'generated by: theme new 2b2f2a'
  [ "$(cat "$HOME/.config/theme")" = green ]
  [ -f "$HOME/Pictures/Wallpapers/green.png" ]
  teardown_fake_home
}

@test "theme new takes a custom name and short hex" {
  copy_repo
  run "$COPY/theme" new '#abc' moss
  [ "$status" -eq 0 ]
  grep -qx 'bg=#aabbcc' "$COPY/themes/moss"
  teardown_fake_home
}

@test "theme new rejects bad input" {
  copy_repo
  run "$COPY/theme" new zz
  [ "$status" -eq 1 ]
  run "$COPY/theme" new '#123456' 'Bad Name'
  [ "$status" -eq 1 ]
  teardown_fake_home
}

@test "theme new never overwrites without --force when nobody can answer" {
  copy_repo
  cp "$COPY/themes/grey" "$BATS_TEST_TMPDIR/grey.orig"
  run "$COPY/theme" new '#282828' grey </dev/null
  [ "$status" -eq 1 ]
  cmp "$COPY/themes/grey" "$BATS_TEST_TMPDIR/grey.orig"
  run "$COPY/theme" new '#282828' grey --force </dev/null
  [ "$status" -eq 0 ]
  head -1 "$COPY/themes/grey" | grep -q 'generated by'
  teardown_fake_home
}

@test "a tinted bg gets the opposite hue as accent; a neutral bg gets gold" {
  a=$(generate_theme '#2b2f2a' | sed -n 's/^accent=//p')
  [[ "$(color_name "$a")" =~ ^(purple|pink)$ ]]
  a=$(generate_theme '#282828' | sed -n 's/^accent=//p')
  [[ "$(color_name "$a")" =~ ^(orange|yellow|brown)$ ]]
}
