# Volume controls
super + equal
    pactl set-sink-volume @DEFAULT_SINK@ +5% && pkill -RTMIN+10 -x dwmblocks

super + minus
    pactl set-sink-volume @DEFAULT_SINK@ -5% && pkill -RTMIN+10 -x dwmblocks

# Brightness controls
super + shift + equal
    brightnessctl set +10%

super + shift + minus
    brightnessctl set 10%-

# Quick app launches
super + n
    st -e nnn

# Window management helpers
super + shift + x
    xkill

super + Escape
    pkill -USR1 -x sxhkd

# Take a full screenshot
super + s
    mkdir -p ~/pictures/screenshots && scrot ~/pictures/screenshots/screenshot_%Y-%m-%d-%H%M%S.png -e 'xclip -selection clipboard -t image/png -i $f' && notify-send -u low screenshot 'saved and copied'

# Take a specific part of the screen
super + shift + s
    mkdir -p ~/pictures/screenshots && scrot -s ~/pictures/screenshots/screenshot_%Y-%m-%d-%H%M%S.png -e 'xclip -selection clipboard -t image/png -i $f' && notify-send -u low screenshot 'saved and copied'

# Pick a color anywhere on screen; its hex goes to the clipboard
super + c
    c=$(xcolor) && printf '%s' "$c" | xclip -selection clipboard && notify-send -u low "color" "$c"

#
# Notification Control System (dunst)
#

ctrl + space
    dunstctl close

ctrl + shift + space
    dunstctl close-all

ctrl + grave
    dunstctl history-pop

ctrl + shift + period
    dunstctl context

super + slash
    keys --menu

super + shift + l
    loginctl lock-session

super + shift + e
    power

super + v
    clip
