#!/usr/bin/env bash
# Repaint the whole machine in one theme.
#   theme          list themes, * marks the current one
#   theme <name>   apply themes/<name> everywhere
#   theme new <color> [name] [--force]
#                  build a whole theme from one background color and apply it
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export REPO_ROOT
# shellcheck source=lib/log.sh
. "$REPO_ROOT/lib/log.sh"
# shellcheck source=lib/theme.sh
. "$REPO_ROOT/lib/theme.sh"
# shellcheck source=lib/generate.sh
. "$REPO_ROOT/lib/generate.sh"

TARGETS=(wallpaper xresources dunst tmux bash zathura nvim emacs vesktop firefox opencode btop rmpc gtk qt gimp kdenlive obs)
for t in "${TARGETS[@]}"; do
  # shellcheck source=/dev/null
  [[ -f "$REPO_ROOT/lib/targets/$t.sh" ]] && . "$REPO_ROOT/lib/targets/$t.sh"
done

STATE="$HOME/.config/theme"
CACHE="$HOME/.cache/theme"

usage() {
  cat <<'USAGE'
usage: theme                          list themes
       theme <name>                   apply a theme
       theme new <color> [name]       build a theme from one color and apply it
                 [--force]            overwrite an existing theme without asking
USAGE
}

list() {
  local current n
  current="$(cat "$STATE" 2>/dev/null || true)"
  while read -r n; do
    if [[ "$n" == "$current" ]]; then printf '* %s\n' "$n"; else printf '  %s\n' "$n"; fi
  done < <(theme_names)
}

# write_colors: the loaded theme as plain assignments, for bash and others
write_colors() {
  local k
  {
    for k in "${THEME_KEYS[@]}"; do printf '%s=%s\n' "$k" "${!k}"; done
    printf 'THEME=%s\n' "$THEME"
  } > "$CACHE/colors.sh"
}

# have_x: a display is set and an X server answers on it
have_x() { [[ -n "${DISPLAY:-}" ]] && xprop -root WM_NAME >/dev/null 2>&1; }

apply() {
  theme_load "$1" || exit 1
  mkdir -p "$CACHE" "$(dirname "$STATE")"
  write_colors
  local t failed=0
  for t in "${TARGETS[@]}"; do
    if declare -F "render_$t" >/dev/null; then
      "render_$t" || { warn "$t: could not write its theme files"; failed=1; }
    fi
  done
  # The files are written: record the theme before any reload can fail.
  printf '%s\n' "$THEME" > "$STATE"
  if have_x; then
    THEME_X=1
  else
    THEME_X=0
    info "no X session: skipping wallpaper and X reloads"
  fi
  export THEME_X
  for t in "${TARGETS[@]}"; do
    if declare -F "reload_$t" >/dev/null; then
      "reload_$t" || warn "$t: reload failed, it picks the theme up on its next start"
    fi
  done
  [[ "$failed" -eq 0 ]] || exit 1
  ok "theme: $THEME"
}

# new <color> [name] [--force]
new() {
  local force=0 args=() color name file
  for a in "$@"; do
    if [[ "$a" == "--force" ]]; then force=1; else args+=("$a"); fi
  done
  [[ ${#args[@]} -ge 1 && ${#args[@]} -le 2 ]] || { usage; exit 1; }
  color="$(normalize_color "${args[0]}")" || { usage; die "not a color: ${args[0]}"; }
  name="${args[1]:-$(color_name "$color")}"
  [[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] || die "theme names are lowercase words: $name"
  file="$REPO_ROOT/themes/$name"
  if [[ -e "$file" && "$force" -eq 0 ]]; then
    [[ -t 0 ]] || die "themes/$name exists; use --force to overwrite"
    local answer
    printf 'overwrite themes/%s? [y/N] ' "$name"
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || { info "kept themes/$name"; exit 1; }
  fi
  {
    printf '# generated by: theme new %s\n' "${args[0]}"
    generate_theme "$color"
  } > "$file.new"
  if ! theme_check "$file.new"; then
    rm -f "$file.new"
    die "could not build a readable theme from $color"
  fi
  mv "$file.new" "$file"
  info "saved themes/$name"
  apply "$name"
}

case "${1:-}" in
  "")        list ;;
  -h|--help) usage ;;
  new)       shift; new "$@" ;;
  *)         apply "$1" ;;
esac
